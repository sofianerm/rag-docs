# Copie ce fichier en .env et remplis les valeurs. Ne commite JAMAIS le .env.

# --- Base de données (Postgres + pgvector) ---
# En local avec Docker Compose :
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Avec Supabase : bouton Connect > Direct > Session pooler
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# --- Embeddings (Voyage AI) ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# --- LLM (API compatible OpenAI : DeepSeek, Claude, Azure OpenAI...) ---
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Description des images (optionnel, nécessite un modèle avec vision) ---
# Laisser vide pour ignorer les images.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# --- Codes produits ---
# Expression régulière des codes produits (détection des comparaisons, gamme déduite du nom de fichier)
PRODUCT_CODE_REGEX=\b[A-Z]{1,3}-[A-Z]{2,5}\b

# --- Découpage ---
CHUNK_MAX_TOKENS=500
